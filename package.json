{
  "name": "pokedex",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "turbo test",
    "wrangler:types": "pnpm --dir apps/web exec wrangler types ./cloudflare-env.d.ts",
    "wrangler:check": "pnpm --dir apps/web exec wrangler check startup",
    "wrangler:dry-run": "pnpm --dir apps/web exec wrangler deploy --dry-run",
    "migrate:local": "pnpm --dir apps/web exec wrangler d1 migrations apply pokedex-local --local"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.15.0",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.0"
  }
}
