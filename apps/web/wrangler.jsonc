{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pokedex-web",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "OWNER_LABEL": "Owner",
    "PUBLIC_ORIGIN": "http://localhost:5173",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pokedex-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
    },
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "00000000000000000000000000000000" },
    { "binding": "RATE_LIMIT", "id": "11111111111111111111111111111111" },
  ],
  "r2_buckets": [{ "binding": "ART", "bucket_name": "pokedex-art-local" }],
  "workflows": [
    {
      "binding": "CATALOGUE_SYNC",
      "name": "pokedex-catalogue-sync",
      "class_name": "CatalogueSyncWorkflow",
      "schedules": ["0 3 * * *"],
    },
    {
      "binding": "PRICE_SYNC",
      "name": "pokedex-price-sync",
      "class_name": "PriceSyncWorkflow",
      "schedules": ["20 3 * * *"],
    },
    {
      "binding": "FX_SYNC",
      "name": "pokedex-fx-sync",
      "class_name": "FxSyncWorkflow",
      "schedules": ["40 3 * * *"],
    },
    {
      "binding": "BACKUP",
      "name": "pokedex-backup",
      "class_name": "BackupWorkflow",
      "schedules": ["0 4 * * *"],
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
}
